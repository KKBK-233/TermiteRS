# 专用虚拟显示器：只在研究或人工验证任务运行时启动。
[Unit]
Description=TermiteRS Google verification display
StopWhenUnneeded=yes

[Service]
User=termiters
Group=termiters
ExecStartPre=/usr/bin/truncate -s 0 /var/lib/termiters/research/google-vnc-tokens
ExecStopPost=/usr/bin/truncate -s 0 /var/lib/termiters/research/google-vnc-tokens
ExecStart=/usr/bin/Xvnc :77 -geometry 1280x950 -depth 24 -localhost yes -interface 127.0.0.1 -rfbport 5977 -SecurityTypes None -AlwaysShared -nolisten tcp
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
