# 人工验收仅执行一个 Google 查询，不运行模型和 README 发布。
[Unit]
Description=TermiteRS manual Google verification
Requires=termiters-research-display.service termiters-research-novnc.service
After=network-online.target termiters-research-display.service termiters-research-novnc.service
JoinsNamespaceOf=termiters-research-display.service

[Service]
Type=oneshot
User=termiters
Group=termiters
WorkingDirectory=/var/lib/termiters
EnvironmentFile=/etc/termiters/research.env
Environment=DISPLAY=:77
ExecStart=/usr/local/bin/TermiteRS research verify-google --config /etc/termiters/research.json
TimeoutStartSec=23min
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/termiters
