[Unit]
Description=TermiteRS automatic upstream sync daemon
After=network-online.target termiters.service
Wants=network-online.target

[Service]
Type=simple
User=termiters
Group=termite-control
SupplementaryGroups=termiters
WorkingDirectory=/opt/termiters
EnvironmentFile=-/etc/termiters/termiters.env
Environment=HOME=/var/lib/termiters
Environment=RUST_LOG=TermiteRS=info
ExecStart=/opt/termiters/TermiteRS daemon --config /etc/termiters/termite.yml
Restart=on-failure
RestartSec=10
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/termiters /run/termiters-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
