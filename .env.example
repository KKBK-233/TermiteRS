# LLM
DEEPSEEK_API_KEY=

# QQ SMTP
QQ_SMTP_USER=your@qq.com
QQ_SMTP_AUTH_CODE=

# Cloudflare Email Service
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Docker
# 只有显式选择 termiters-maintainer 服务时才会挂载 SSH 目录。
# Windows example: C:\Users\your-name\.ssh
# Linux example: /home/your-name/.ssh
TERMITE_SSH_DIR=
# 默认服务只读挂载；maintainer 服务才拥有写权限。
TERMITE_PROJECT_DIR=../project
